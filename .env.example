REPOMIND_ENV=development
REPOMIND_DATA_DIR=./data
REPOMIND_REPORTS_DIR=./reports
REPOMIND_INDEX_DIR=./data/indexes
REPOMIND_CHROMA_DIR=./data/chroma
REPOMIND_UPLOAD_DIR=./data/uploads
REPOMIND_MODEL_PATH=./models/qwen-judge
REPOMIND_ENABLE_MODEL_INFERENCE=true
REPOMIND_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
REPOMIND_AUTO_DELETE_AFTER_ANALYSIS=true
REPOMIND_RETENTION_MINUTES=60
REPOMIND_CLEANUP_INTERVAL_SECONDS=300
REPOMIND_EMBEDDING_BATCH_SIZE=64
REPOMIND_CHROMA_UPSERT_BATCH_SIZE=1000
REPOMIND_FRONTEND_ORIGIN=http://localhost:3000
REPOMIND_DATABASE_URL=sqlite:///./data/repomind.db
REPOMIND_ANALYSIS_WORKERS=2
REPOMIND_MAX_REPOSITORY_FILES=50000
REPOMIND_MAX_INDEXED_CHUNKS=100000
REPOMIND_API_KEY=change-this-local-api-key
REPOMIND_REQUIRE_API_KEY=true
REPOMIND_AUTH_SECRET=change-this-32-character-session-secret
REPOMIND_SECRET_KEY=change-this-32-character-encryption-secret
REPOMIND_RATE_LIMIT_REQUESTS=120
REPOMIND_RATE_LIMIT_WINDOW_SECONDS=60
REPOMIND_REDIS_URL=
REPOMIND_ANALYSIS_QUEUE_BACKEND=local
REPOMIND_ANALYSIS_JOB_TIMEOUT_SECONDS=3600
REPOMIND_ANALYSIS_JOB_RETRIES=2
REPOMIND_QUEUE_BACKLOG_ALERT_THRESHOLD=25
REPOMIND_LATENCY_ALERT_P95_MS=5000
REPOMIND_ALERT_WEBHOOK_URL=
REPOMIND_ALERT_SLACK_WEBHOOK_URL=
REPOMIND_ALERT_EMAIL_TO=
REPOMIND_ALERT_EMAIL_FROM=
REPOMIND_ALERT_SMTP_HOST=
REPOMIND_ALERT_SMTP_PORT=587
REPOMIND_ALERT_SMTP_USERNAME=
REPOMIND_ALERT_SMTP_PASSWORD=
REPOMIND_ENABLE_LOCAL_PATH_IMPORT=false
REPOMIND_LOCAL_IMPORT_ALLOWED_ROOTS=./sample_repos
REPOMIND_ALLOWED_GIT_HOSTS=github.com
REPOMIND_MAX_UPLOAD_BYTES=50000000
REPOMIND_MAX_ZIP_MEMBERS=20000
REPOMIND_MAX_ZIP_EXTRACTED_BYTES=250000000
REPOMIND_MAX_ZIP_COMPRESSION_RATIO=100
REPOMIND_REDACT_SECRETS=true
REPOMIND_TRUST_REMOTE_MODEL_CODE=false
REPOMIND_PUBLIC_APP_URL=http://localhost:3000
REPOMIND_GITHUB_API_URL=https://api.github.com
REPOMIND_GITHUB_GRAPHQL_URL=https://api.github.com/graphql
REPOMIND_GITHUB_OAUTH_CLIENT_ID=
REPOMIND_GITHUB_OAUTH_CLIENT_SECRET=
REPOMIND_GITHUB_APP_SLUG=
REPOMIND_GITHUB_APP_ID=
REPOMIND_GOOGLE_OAUTH_CLIENT_ID=
REPOMIND_GOOGLE_OAUTH_CLIENT_SECRET=
